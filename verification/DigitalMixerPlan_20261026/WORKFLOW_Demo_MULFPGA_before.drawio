        <mxCell id="main_note" value="Both TX and RX paths are on the main board.&lt;br&gt;TX sends analog voltage to the front end; RX receives its output.&lt;br&gt;One FPGA controls the DAC, ADC and PC communication." style="fontFamily=Arial;html=1;text;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;fontSize=14;fontColor=#065f46;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="235" y="272" width="470" height="80" as="geometry" />
        </mxCell>
        <mxCell id="front_note" value="Both TX and RX paths are on the front-end board.&lt;br&gt;TX provides drive power; RX buffers and amplifies weak signals.&lt;br&gt;Jumper P4 selects raw RX or RX multiplied by the TX reference." style="fontFamily=Arial;html=1;text;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;fontSize=14;fontColor=#9a3412;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="775" y="272" width="470" height="80" as="geometry" />
        </mxCell>
        <mxCell id="same_names" value="Analog connections: main-board TX → front-end TX; front-end RX → main-board RX. These are not UART TX/RX cross-connections." style="fontFamily=Arial;html=1;text;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;fontSize=16;fontColor=#0f172a;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="519" width="1400" height="32" as="geometry" />
        </mxCell>
        <mxCell id="mix_title" value="Front-End Jumper P4 Determines Which Signal Reaches the PC" style="fontFamily=Arial;html=1;text;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;fontSize=21;fontColor=#0f172a;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="579" width="1400" height="33" as="geometry" />
        </mxCell>
        <mxCell id="raw" value="&lt;b&gt;Current Goal: Raw 200 kHz RX Capture&lt;/b&gt;&lt;br&gt;&lt;br&gt;P4 pins 2–3: Rx_Amp → Rx_Out → front-end P5.&lt;br&gt;Disable main-board RX Filter to bypass the ~15 kHz low-pass path.&lt;br&gt;The ADC captures the carrier waveform; other analog conditioning remains." style="fontFamily=Arial;html=1;rounded=1;arcSize=10;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;spacing=14;" parent="1" vertex="1">
          <mxGeometry x="40" y="632" width="680" height="146" as="geometry" />
        </mxCell>
        <mxCell id="mixed" value="&lt;b&gt;Alternative Hardware Path: Analog Mixing&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tx_Buff and Rx_Amp → U11 AD835 → Rx_Mix.&lt;br&gt;P4 pins 1–2: Rx_Mix → Rx_Out → front-end P5.&lt;br&gt;With main-board low-pass filtering, capture the beat signal instead of raw RX." style="fontFamily=Arial;html=1;rounded=1;arcSize=10;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#9a3412;spacing=14;" parent="1" vertex="1">
          <mxGeometry x="740" y="632" width="700" height="146" as="geometry" />
        </mxCell>
        <mxCell id="details" value="&lt;b&gt;Hardware Details Behind the Workflow&lt;/b&gt;&lt;br&gt;The main board also conditions analog signals: TX selects attenuation / filtering; RX uses U14 selection, U17 gain, U22 THS4551 differential drive, then U21 ADC.&lt;br&gt;The UI label &quot;RX 0 dB&quot; names a gain setting; it does not mean unity gain across the whole RX chain. Software RX Filter does not switch the front-end mixer jumper." style="fontFamily=Arial;html=1;rounded=1;arcSize=10;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;spacing=14;" parent="1" vertex="1">
          <mxGeometry x="40" y="803" width="1400" height="103" as="geometry" />
        </mxCell>
        <mxCell id="limits" value="Scope: saved A0 schematics and project debug notes. Physical jumpers, wiring and rework are unverified; confirm P4 pin numbers on the actual board." style="fontFamily=Arial;html=1;text;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;fontSize=14;fontColor=#64748b;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="935" width="1400" height="28" as="geometry" />
        </mxCell>
        <mxCell id="status" value="Layered RTL checks have passed. Amplitude and distortion through the 200 kHz analog / acoustic path still require hardware measurements." style="fontFamily=Arial;html=1;text;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;fontSize=14;fontColor=#64748b;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="974" width="1400" height="28" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
