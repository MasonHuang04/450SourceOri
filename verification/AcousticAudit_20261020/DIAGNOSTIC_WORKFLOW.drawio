<mxfile host="app.diagrams.net"><diagram name="Acoustic diagnosis 2026-10-20" id="acoustic-audit"><mxGraphModel dx="1400" dy="950" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="950"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Current Main + acoustic diagnostic workflow&#10;40 kHz center | 4 kHz bandwidth | 20 ms TX | distances in cm" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#728797;fontSize=23;"><mxGeometry as="geometry" x="60" y="30" width="1240" height="80" /></mxCell><mxCell id="w0" value="TX 38–42 kHz / 20 ms&#10;&#10;Electrical amplitude and timing verified" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9f4fb;strokeColor=#728797;fontSize=16;"><mxGeometry as="geometry" x="60" y="150" width="380" height="125" /></mxCell><mxCell id="w1" value="TX transducer → reflector → RX&#10;&#10;Unknown H(f), geometry, leakage and multipath" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff1dd;strokeColor=#728797;fontSize=16;"><mxGeometry as="geometry" x="490" y="150" width="380" height="125" /></mxCell><mxCell id="e1" source="w0" target="w1" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#526b7c;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="w2" value="Analog mixer × TX reference → LPF&#10;&#10;Preserves amplitude envelope; check offsets / clipping" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff1dd;strokeColor=#728797;fontSize=16;"><mxGeometry as="geometry" x="920" y="150" width="380" height="125" /></mxCell><mxCell id="e2" source="w1" target="w2" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#526b7c;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="w3" value="ADC → CIC /32 → mean removal&#10;&#10;672 effective samples; 18.77 ms" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9f4fb;strokeColor=#728797;fontSize=16;"><mxGeometry as="geometry" x="920" y="330" width="380" height="125" /></mxCell><mxCell id="e3" source="w2" target="w3" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#526b7c;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="w4" value="Kaiser4 → FFT → power → global maximum&#10;&#10;1024 FFT; strongest peak may change identity" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9f4fb;strokeColor=#728797;fontSize=16;"><mxGeometry as="geometry" x="490" y="330" width="380" height="125" /></mxCell><mxCell id="e4" source="w3" target="w4" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#526b7c;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="w5" value="FPGA peak interpolation → UART&#10;&#10;±0.5 bin only; no automatic distance conversion" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9f4fb;strokeColor=#728797;fontSize=16;"><mxGeometry as="geometry" x="60" y="330" width="380" height="125" /></mxCell><mxCell id="e5" source="w4" target="w5" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#526b7c;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="measure" value="1. Capture fixed distances&#10;5 / 7.5 / 10 / 12.5 / 15 cm&#10;TX reference + raw RX + IF&#10;Save waveform, gain and distance labels" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9f4fb;strokeColor=#728797;fontSize=16;"><mxGeometry as="geometry" x="60" y="540" width="280" height="160" /></mxCell><mxCell id="compare" value="2. Identify the selected peak&#10;Full spectrum / top 3 local peaks&#10;Raw bin vs interpolation&#10;Harmonic / leakage / clipping checks" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9f4fb;strokeColor=#728797;fontSize=16;"><mxGeometry as="geometry" x="380" y="540" width="280" height="160" /></mxCell><mxCell id="calibrate" value="3. Calibrate one stable branch&#10;Fit f = aR + b, validate other positions&#10;Measure amplitude + phase vs frequency&#10;No arbitrary correction of jump frames" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9f4fb;strokeColor=#728797;fontSize=16;"><mxGeometry as="geometry" x="700" y="540" width="280" height="160" /></mxCell><mxCell id="improve" value="4. Validate improvement offline&#10;Confidence / harmonic checks&#10;Bounded response compensation&#10;Then consider FPGA integration" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e6f3e9;strokeColor=#728797;fontSize=16;"><mxGeometry as="geometry" x="1020" y="540" width="280" height="160" /></mxCell><mxCell id="d0" source="measure" target="compare" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#526b7c;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="d1" source="compare" target="calibrate" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#526b7c;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="d2" source="calibrate" target="improve" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#526b7c;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="limit" value="Evidence: production RTL passes controlled tests; actual logs show bin jumps.&#10;Not established: which acoustic mechanism caused the 12.5 cm observation.&#10;No production FPGA, GUI, SOF or original backup was changed by this audit." parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff1dd;strokeColor=#728797;fontSize=18;"><mxGeometry as="geometry" x="60" y="770" width="1240" height="100" /></mxCell></root></mxGraphModel></diagram></mxfile>