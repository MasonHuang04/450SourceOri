<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="wiringA0" name="板卡连接与供电">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1680" pageHeight="1120" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="主板 + 前端板：实际搭接示意" vertex="1" parent="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=29;fontColor=#0f172a;fontStyle=1;">
          <mxGeometry as="geometry" x="40" y="25" width="1350" height="48" />
        </mxCell>
        <mxCell id="sub" value="按已有焊接好的 A0 板卡绘制｜图示方案：主板 USB 供电，前端独立 5 V 供电｜2026-10-15" vertex="1" parent="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=15;fontColor=#64748b;fontStyle=0;">
          <mxGeometry as="geometry" x="40" y="80" width="1500" height="32" />
        </mxCell>
        <mxCell id="legend" value="蓝色：USB 数据与供电　　红色：5 V 电源线　　深灰：模拟信号线　　紫色虚线：声学传播 / 可选下载连接" vertex="1" parent="1" style="fontFamily=Microsoft YaHei;html=1;text;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=14;fontColor=#64748b;fontStyle=0;">
          <mxGeometry as="geometry" x="40" y="125" width="1600" height="30" />
        </mxCell>
