          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e_rx_probe_frontend" value="" source="rx_probe" target="frontend" parent="1" edge="1" style="fontFamily=Microsoft YaHei;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#ea580c;strokeWidth=2;fontSize=11;fontColor=#ea580c;labelBackgroundColor=#ffffff;dashed=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e_frontend_adc" value="" source="frontend" target="adc" parent="1" edge="1" style="fontFamily=Microsoft YaHei;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#ea580c;strokeWidth=2;fontSize=11;fontColor=#ea580c;labelBackgroundColor=#ffffff;dashed=0;">
