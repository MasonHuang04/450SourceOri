          <mxGeometry as="geometry" x="400" y="400" width="140" height="60" />
        </mxCell>
        <mxCell id="fpga_rx" value="&lt;b&gt;FPGA 接收逻辑&lt;/b&gt;&lt;br&gt;SPI 读 ADC → FIFO&lt;br&gt;1 MS/s · 16 bit · 84 ms" vertex="1" parent="1" style="fontFamily=Microsoft YaHei;html=1;rounded=1;arcSize=16;whiteSpace=wrap;fontSize=12;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;spacing=4;strokeWidth=1.5;">
