          <mxGeometry as="geometry" x="220" y="118" width="180" height="22" />
        </mxCell>
        <mxCell id="legend_analog" value="● 板上模拟器件 / 声学链路" style="fontFamily=Microsoft YaHei;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#ea580c;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="430" y="118" width="320" height="22" />
        </mxCell>
        <mxCell id="legend_dash" value="虚线 = 控制；实线 = 数据 / 信号" style="fontFamily=Microsoft YaHei;text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=13;fontColor=#64748b;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="850" y="118" width="410" height="22" />
        </mxCell>
        <mxCell id="pc_config" value="&lt;b&gt;① 电脑配置 / 触发&lt;/b&gt;&lt;br&gt;200 kHz · 20 kHz 带宽&lt;br&gt;C# 上位机 / COM" style="fontFamily=Microsoft YaHei;rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=12;spacing=5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="160" width="140" height="60" />
        </mxCell>
        <mxCell id="uart_down" value="&lt;b&gt;UART 下行&lt;/b&gt;&lt;br&gt;配置包 + 手动触发&lt;br&gt;2 Mbaud · 8N1" style="fontFamily=Microsoft YaHei;rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;fontSize=12;spacing=5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="220" y="160" width="140" height="60" />
        </mxCell>
        <mxCell id="control" value="&lt;b&gt;② FPGA 统一控制&lt;/b&gt;&lt;br&gt;RxDepack 解析命令&lt;br&gt;顶层同时启动 TX / RX" style="fontFamily=Microsoft YaHei;rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;fontSize=12;spacing=5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="400" y="160" width="140" height="60" />
        </mxCell>
        <mxCell id="tx_ctrl" value="&lt;b&gt;TX 控制&lt;/b&gt;&lt;br&gt;TxController&lt;br&gt;发射窗 80 ms" style="fontFamily=Microsoft YaHei;rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;fontSize=12;spacing=5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="580" y="160" width="140" height="60" />
        </mxCell>
        <mxCell id="chirp" value="&lt;b&gt;③ Chirp 生成&lt;/b&gt;&lt;br&gt;ChirpWaveGen&lt;br&gt;190 → 210 kHz" style="fontFamily=Microsoft YaHei;rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;fontSize=12;spacing=5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="760" y="160" width="140" height="60" />
        </mxCell>
        <mxCell id="dac" value="&lt;b&gt;DAC 转模拟电压&lt;/b&gt;&lt;br&gt;14 bit · 96 MS/s&lt;br&gt;DAC904" style="fontFamily=Microsoft YaHei;rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#9a3412;fontSize=12;spacing=5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="160" width="140" height="60" />
        </mxCell>
        <mxCell id="tx_probe" value="&lt;b&gt;发射驱动 + TX 探头&lt;/b&gt;&lt;br&gt;电压 → 超声波&lt;br&gt;需匹配 200 kHz" style="fontFamily=Microsoft YaHei;rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#9a3412;fontSize=12;spacing=5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1120" y="160" width="140" height="60" />
        </mxCell>
        <mxCell id="channel" value="&lt;b&gt;传播 / 目标反射&lt;/b&gt;&lt;br&gt;产生延迟与衰减&lt;br&gt;实物链路待测" style="fontFamily=Microsoft YaHei;rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#9a3412;fontSize=12;spacing=5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1120" y="280" width="140" height="60" />
        </mxCell>
        <mxCell id="rx_probe" value="&lt;b&gt;RX 接收探头&lt;/b&gt;&lt;br&gt;超声波 → 微弱电压&lt;br&gt;可能含噪声和多回波" style="fontFamily=Microsoft YaHei;rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#9a3412;fontSize=12;spacing=5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1120" y="400" width="140" height="60" />
        </mxCell>
        <mxCell id="frontend" value="&lt;b&gt;接收模拟前端&lt;/b&gt;&lt;br&gt;增益 / 电平调理&lt;br&gt;混频 / 15k 低通旁路" style="fontFamily=Microsoft YaHei;rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#9a3412;fontSize=12;spacing=5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="400" width="140" height="60" />
        </mxCell>
        <mxCell id="adc" value="&lt;b&gt;④ ADC 采样&lt;/b&gt;&lt;br&gt;ADS127L21 · 16 bit&lt;br&gt;1 MS/s；CLK 24 MHz" style="fontFamily=Microsoft YaHei;rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#9a3412;fontSize=12;spacing=5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="760" y="400" width="140" height="60" />
        </mxCell>
        <mxCell id="rx_rtl" value="&lt;b&gt;RX 控制 / SPI 读取&lt;/b&gt;&lt;br&gt;RxController&lt;br&gt;+ ADC SPI 驱动" style="fontFamily=Microsoft YaHei;rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;fontSize=12;spacing=5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="580" y="400" width="140" height="60" />
        </mxCell>
        <mxCell id="fifo" value="&lt;b&gt;⑤ 缓存 / 打包&lt;/b&gt;&lt;br&gt;WaveFIFO + TxPack&lt;br&gt;先存样本，采完再回传" style="fontFamily=Microsoft YaHei;rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;fontSize=12;spacing=5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="400" y="400" width="140" height="60" />
        </mxCell>
        <mxCell id="uart_up" value="&lt;b&gt;⑥ UART 回传&lt;/b&gt;&lt;br&gt;FPGA → 电脑 COM&lt;br&gt;2 Mbaud · 8N1" style="fontFamily=Microsoft YaHei;rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;fontSize=12;spacing=5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="220" y="400" width="140" height="60" />
        </mxCell>
        <mxCell id="pc_show" value="&lt;b&gt;⑦ 电脑解析 / 显示&lt;/b&gt;&lt;br&gt;C# 拼完整帧 → RX 波形&lt;br&gt;可保存采样数据" style="fontFamily=Microsoft YaHei;rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=12;spacing=5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="400" width="140" height="60" />
        </mxCell>
        <mxCell id="rx_window" value="&lt;b&gt;并行开启采集&lt;/b&gt;&lt;br&gt;RX 窗口 84 ms&lt;br&gt;配置启动延迟 = 0" style="fontFamily=Microsoft YaHei;rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;fontSize=12;spacing=5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="400" y="280" width="140" height="60" />
        </mxCell>
