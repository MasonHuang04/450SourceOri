          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e_fifo_uart_up" value="" source="fifo" target="uart_up" parent="1" edge="1" style="fontFamily=Microsoft YaHei;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;dashed=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
