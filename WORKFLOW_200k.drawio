          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e10" source="front_p6" target="front_rx" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
