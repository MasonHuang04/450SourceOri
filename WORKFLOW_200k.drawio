        <mxCell id="title" value="200 kHz Chirp｜发射、采集与电脑显示" style="fontFamily=Microsoft YaHei;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=29;fontColor=#0f172a;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="26" width="1000" height="44" />
        </mxCell>
        <mxCell id="subtitle" value="当前工作流程 · 190–210 kHz · TX 80 ms / RX 84 ms · 2026-10-13" style="fontFamily=Microsoft YaHei;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#64748b;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="78" width="1000" height="25" />
        </mxCell>
        <mxCell id="legend_pc" value="● 电脑软件" style="fontFamily=Microsoft YaHei;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#2563eb;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
