          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e14" source="main_rx" target="fpga_rx" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e15" source="fpga_rx" target="pc_rx" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="main_note" value="主板同时有 TX 和 RX。&lt;br&gt;TX 向前端输出模拟电压；RX 接收前端送回的模拟电压。&lt;br&gt;ADC / DAC 与电脑通信由同一颗 FPGA 控制。" vertex="1" parent="1" style="fontFamily=Microsoft YaHei;html=1;text;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;fontSize=14;fontColor=#065f46;fontStyle=0;">
          <mxGeometry as="geometry" x="235" y="272" width="470" height="80" />
        </mxCell>
        <mxCell id="front_note" value="前端同时有 TX 和 RX。&lt;br&gt;TX 负责提高驱动能力；RX 负责小信号缓冲 / 放大。&lt;br&gt;P4 跳线决定送回原始 RX，还是 RX × TX 参考。" vertex="1" parent="1" style="fontFamily=Microsoft YaHei;html=1;text;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;fontSize=14;fontColor=#9a3412;fontStyle=0;">
          <mxGeometry as="geometry" x="775" y="272" width="470" height="80" />
        </mxCell>
        <mxCell id="same_names" value="板间按通道连接：主板 TX → 前端 TX；前端 RX → 主板 RX。两条都是模拟链路，不按 UART 的 TX / RX 名字交叉接。" vertex="1" parent="1" style="fontFamily=Microsoft YaHei;html=1;text;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;fontSize=16;fontColor=#0f172a;fontStyle=1;">
          <mxGeometry as="geometry" x="40" y="519" width="1400" height="32" />
        </mxCell>
        <mxCell id="mix_title" value="前端 P4 的两种选择，决定电脑最终收到什么" vertex="1" parent="1" style="fontFamily=Microsoft YaHei;html=1;text;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;fontSize=21;fontColor=#0f172a;fontStyle=1;">
          <mxGeometry as="geometry" x="40" y="579" width="1400" height="33" />
        </mxCell>
        <mxCell id="raw" value="&lt;b&gt;当前目标：采集原始 200 kHz RX&lt;/b&gt;&lt;br&gt;&lt;br&gt;P4 的 2–3 脚：Rx_Amp → Rx_Out → 前端 P5。&lt;br&gt;主板 RX Filter 关闭，旁路主板约 15 kHz 低通。&lt;br&gt;ADC 采到载频附近的原始波形；主板其余调理仍存在。" vertex="1" parent="1" style="fontFamily=Microsoft YaHei;html=1;rounded=1;arcSize=10;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;spacing=14;">
          <mxGeometry as="geometry" x="40" y="632" width="680" height="146" />
        </mxCell>
        <mxCell id="mixed" value="&lt;b&gt;原设计保留的选择：模拟混频&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tx_Buff 与 Rx_Amp → U11 AD835 → Rx_Mix。&lt;br&gt;P4 的 1–2 脚：Rx_Mix → Rx_Out → 前端 P5。&lt;br&gt;配合主板低通，可采差频信号；这不是当前原始 RX 模式。" vertex="1" parent="1" style="fontFamily=Microsoft YaHei;html=1;rounded=1;arcSize=10;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#9a3412;spacing=14;">
          <mxGeometry as="geometry" x="740" y="632" width="700" height="146" />
        </mxCell>
        <mxCell id="details" value="&lt;b&gt;此前流程图需要补充的地方&lt;/b&gt;&lt;br&gt;主板上也有模拟电路：TX 有衰减 / 滤波选择；RX 有 U14 选择、U17 放大、U22 THS4551 差分驱动，再到 U21 ADC。&lt;br&gt;界面“RX 0 dB”是原软件的档位名，不表示整条接收链路完全不放大。前端混频跳线也不受软件 RX Filter 按钮控制。" vertex="1" parent="1" style="fontFamily=Microsoft YaHei;html=1;rounded=1;arcSize=10;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;spacing=14;">
          <mxGeometry as="geometry" x="40" y="803" width="1400" height="103" />
        </mxCell>
        <mxCell id="limits" value="核对范围：磁盘中 A0 原理图与项目调试记录；未确认实物跳线 / 飞线 / 焊接改动。P4 脚位须按实物丝印和导通确认后设置。" vertex="1" parent="1" style="fontFamily=Microsoft YaHei;html=1;text;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;fontSize=14;fontColor=#64748b;fontStyle=0;">
          <mxGeometry as="geometry" x="40" y="935" width="1400" height="28" />
        </mxCell>
