          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="control_rx" value="" source="control" target="rx_window" parent="1" edge="1" style="fontFamily=Microsoft YaHei;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#059669;strokeWidth=2;fontSize=11;fontColor=#059669;labelBackgroundColor=#ffffff;dashed=1;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="window_rx" value="" source="rx_window" target="rx_rtl" parent="1" edge="1" style="fontFamily=Microsoft YaHei;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#059669;strokeWidth=2;fontSize=11;fontColor=#059669;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="same_uart" value="&lt;b&gt;UART 是电脑与 FPGA 之间的通道&lt;/b&gt;&lt;br&gt;下发参数，回传采样数据；&lt;br&gt;声音的传播延迟由 RX 波形体现。" style="fontFamily=Microsoft YaHei;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=14;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="262" width="320" height="94" />
        </mxCell>
        <mxCell id="raw_mode" value="&lt;b&gt;当前采集的是原始 200 kHz RX 波形&lt;/b&gt;&lt;br&gt;TX 与 RX 在时间上重叠；ADC → FPGA 走 SPI。&lt;br&gt;模拟乘法器旁路，尚未接入去斜 / FFT / 测距。" style="fontFamily=Microsoft YaHei;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=13;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="760" y="260" width="320" height="98" />
        </mxCell>
        <mxCell id="rtn_note" value="← 回传顺序：ADC 样本 → FIFO → 完整数据包 → UART → 上位机曲线" style="fontFamily=Microsoft YaHei;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#475569;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="483" width="1220" height="24" />
        </mxCell>
        <mxCell id="timing_title" value="一次触发之后，时间如何安排？" style="fontFamily=Microsoft YaHei;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=21;fontColor=#0f172a;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="539" width="1100" height="30" />
        </mxCell>
        <mxCell id="tx_label" value="TX 发射" style="fontFamily=Microsoft YaHei;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#065f46;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="590" width="130" height="32" />
        </mxCell>
        <mxCell id="rx_label" value="RX 采集" style="fontFamily=Microsoft YaHei;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#065f46;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="637" width="130" height="32" />
        </mxCell>
        <mxCell id="uart_label" value="UART 回传" style="fontFamily=Microsoft YaHei;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#1e3a8a;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="684" width="130" height="32" />
        </mxCell>
        <mxCell id="tx_bar" value="190 → 210 kHz，持续 80 ms" style="fontFamily=Microsoft YaHei;rounded=1;arcSize=12;html=1;fillColor=#d1fae5;strokeColor=#059669;fontColor=#065f46;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="190" y="590" width="400" height="32" />
        </mxCell>
        <mxCell id="rx_bar" value="84 ms；采样间隔 1 μs" style="fontFamily=Microsoft YaHei;rounded=1;arcSize=12;html=1;fillColor=#d1fae5;strokeColor=#059669;fontColor=#065f46;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="190" y="637" width="420" height="32" />
        </mxCell>
        <mxCell id="uart_bar" value="采集结束后：理论线速约 0.84 s + 握手间隙" style="fontFamily=Microsoft YaHei;rounded=1;arcSize=12;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="630" y="684" width="630" height="32" />
        </mxCell>
        <mxCell id="tx_time" value="80 ms" style="fontFamily=Microsoft YaHei;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#64748b;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="598" y="590" width="100" height="32" />
        </mxCell>
        <mxCell id="rx_time" value="84 ms" style="fontFamily=Microsoft YaHei;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#64748b;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="618" y="637" width="100" height="32" />
        </mxCell>
        <mxCell id="timeline_explain" value="示意，UART 段压缩显示。TX / RX 实际起点含流水线与 ADC 启动延迟；每帧收到后才更新显示，约 1 秒量级。" style="fontFamily=Microsoft YaHei;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#64748b;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="736" width="1220" height="25" />
        </mxCell>
        <mxCell id="frame" value="&lt;b&gt;这一帧有什么？&lt;/b&gt;&lt;br&gt;&lt;br&gt;约 84,000 个 RX 样本；仿真实际为 83,994 点。&lt;br&gt;32 B 包头 + 2 × N B 采样数据 + 32 B 包尾。&lt;br&gt;包头记录实际点数与采样间隔，完整帧约 168 kB。" style="fontFamily=Microsoft YaHei;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=14;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="795" width="590" height="137" />
        </mxCell>
        <mxCell id="verified" value="&lt;b&gt;目前验证到哪里？&lt;/b&gt;&lt;br&gt;&lt;br&gt;已通过：80 ms TX、84 ms 采集、短 UART、长帧缓存 / 打包。&lt;br&gt;理想回波测试：延迟 2 ms、增益 0.5；实物链路仍待上板验证。&lt;br&gt;完整长帧 UART 逐位仿真已按要求停止，采用分层验证。" style="fontFamily=Microsoft YaHei;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=14;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="795" width="610" height="137" />
        </mxCell>
        <mxCell id="files" value="代码定位：02_RTL / V0 / SourceCode → FPGA　｜　03_SW / UsMimoTestBench → C# 上位机　｜　verification → 验证证据" style="fontFamily=Microsoft YaHei;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#64748b;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="959" width="1220" height="28" />
        </mxCell>
        <mxCell id="pc_detail" value="上位机数据流：USSensor.cs 读串口 → SerialFrameParser.cs 拼帧 → MainFrm.cs 显示 / 录制。采样文件 t = 0 对应首个 ADC 样本。" style="fontFamily=Microsoft YaHei;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#64748b;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="998" width="1220" height="24" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
