        </mxCell>
        <mxCell id="note_rate" value="&lt;b&gt;Low-pass and /32 are both inside the FPGA&lt;/b&gt;&lt;br&gt;Drawn separately; the existing CIC decimator combines them.&lt;br&gt;Keep the full ADC rate until AFTER digital multiplication." style="fontFamily=Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;fontSize=15;spacing=9;strokeWidth=1.5;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="600" y="915" width="520" height="82" as="geometry" />
