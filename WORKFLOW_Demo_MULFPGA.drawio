        <mxCell id="t6_2" value="672 effective samples + 352 zeros; 18.767 ms" style="fontFamily=Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=14;spacing=9;strokeWidth=1.5;align=left;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="605" y="685" width="475" height="43" as="geometry" />
        </mxCell>
        <mxCell id="t7_0" value="FFT engine / search" style="fontFamily=Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=14;spacing=9;strokeWidth=1.5;align=left;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="728" width="290" height="43" as="geometry" />
        </mxCell>
        <mxCell id="t7_1" value="50 MHz / bins 1-57" style="fontFamily=Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=14;spacing=9;strokeWidth=1.5;align=left;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="330" y="728" width="275" height="43" as="geometry" />
        </mxCell>
        <mxCell id="t7_2" value="Bin spacing 34.968058 Hz; Q16 interpolation" style="fontFamily=Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=14;spacing=9;strokeWidth=1.5;align=left;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="605" y="728" width="475" height="43" as="geometry" />
        </mxCell>
        <mxCell id="t8_0" value="Distance calculation" style="fontFamily=Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=14;spacing=9;strokeWidth=1.5;align=left;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="771" width="290" height="43" as="geometry" />
        </mxCell>
        <mxCell id="t8_1" value="c(T) = 331.3 + 0.606 T" style="fontFamily=Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=14;spacing=9;strokeWidth=1.5;align=left;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="330" y="771" width="275" height="43" as="geometry" />
        </mxCell>
        <mxCell id="t8_2" value="R = c(T) fb Tc / (2B); calibrate fixed path delay" style="fontFamily=Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=14;spacing=9;strokeWidth=1.5;align=left;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="605" y="771" width="475" height="43" as="geometry" />
        </mxCell>
        <mxCell id="format" value="&lt;b&gt;Numeric format contract&lt;/b&gt;&lt;br&gt;ADC path: signed16; do not mix unsigned UART codes.&lt;br&gt;Reference: signed Q1.15 from the same TX phase.&lt;br&gt;Mixer: full 32-bit product; specified scale / rounding / saturation.&lt;br&gt;Feed signed16 to the existing 40-bit CIC integrators.&lt;br&gt;Keep ADC-clip and mixer-clip flags distinct." style="fontFamily=Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;fontSize=15;spacing=9;strokeWidth=1.5;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1120" y="385" width="560" height="210" as="geometry" />
        </mxCell>
        <mxCell id="code_map" value="&lt;b&gt;Integration implemented&lt;/b&gt;&lt;br&gt;ChirpModules.vhd: amplitude-scaled square + coherent sine tap.&lt;br&gt;RxAcquisition.sv: paired ADC/reference + signed mixer.&lt;br&gt;Existing CIC / FFT / peak / interpolation / range reused.&lt;br&gt;UsMimoTestBench.vhd: Main square TX enabled; chirp validity retained.&lt;br&gt;MainProtocol.cs: square TX flag; raw RX configuration." style="fontFamily=Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#047857;fontColor=#064e3b;fontSize=15;spacing=9;strokeWidth=1.5;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1120" y="620" width="560" height="194" as="geometry" />
        </mxCell>
        <mxCell id="lpf_design" value="&lt;b&gt;Digital low-pass: existing CIC3 /32&lt;/b&gt;&lt;br&gt;Equivalent response: three length-32 moving averages (94-tap FIR response).&lt;br&gt;0-2 kHz maximum droop: 0.134 dB.&lt;br&gt;76-84 kHz sum-band attenuation: 55.00-74.79 dB.&lt;br&gt;-3 dB frequency: 9.368 kHz; group delay: 40.582 us.&lt;br&gt;Implement efficiently with integrators, a /32 rate change and comb stages." style="fontFamily=Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;fontSize=16;spacing=9;strokeWidth=1.5;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="850" width="800" height="170" as="geometry" />
        </mxCell>
        <mxCell id="lpf_scope" value="&lt;b&gt;What the low-pass does&lt;/b&gt;&lt;br&gt;Retain the beat signal; suppress the sum term before output-rate reduction.&lt;br&gt;No external post-mixer IF low-pass is needed for this digital path.&lt;br&gt;Analog RX conditioning and ADC-input band limiting still remain.&lt;br&gt;25-2000 Hz is the PEAK SEARCH range, not a sharp filter cutoff.&lt;br&gt;Add a sharper FIR only if later measurements require more rejection." style="fontFamily=Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;fontSize=16;spacing=9;strokeWidth=1.5;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="880" y="850" width="800" height="170" as="geometry" />
        </mxCell>
        <mxCell id="timing" value="&lt;b&gt;Reference timing and calibration&lt;/b&gt;&lt;br&gt;Reference travels with its ADC word; SPI readout does not retime the pair.&lt;br&gt;Configured history: 18 + reference_extra_delay_cycles at 165 MHz.&lt;br&gt;Extra delay defaults to 0; ADC / analog group delay is not yet calibrated.&lt;br&gt;Calibrate electronics separately; preserve the acoustic propagation delay." style="fontFamily=Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;fontSize=16;spacing=9;strokeWidth=1.5;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="1050" width="800" height="160" as="geometry" />
        </mxCell>
        <mxCell id="square" value="&lt;b&gt;Square TX and sine reference: implemented&lt;/b&gt;&lt;br&gt;One phase sweep creates A sign(cos phase) for TX and A cos(phase) for mixing.&lt;br&gt;TX amplitude remains configurable; A=0.25 gives DAC codes 6144 / 10240.&lt;br&gt;A square chirp remains valid for distance; zero bandwidth remains invalid.&lt;br&gt;RX follows the delayed fundamental; no second reference ADC is required." style="fontFamily=Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;fontSize=16;spacing=9;strokeWidth=1.5;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="880" y="1050" width="800" height="160" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="&lt;b&gt;RTL and timing verified; hardware calibration pending&lt;/b&gt;&lt;br&gt;27 ideal distances: max |error| 0.464 mm; 84 timing scenarios passed.&lt;br&gt;Full Main RF/SPI/M4: 50 cm model -&amp;gt; 500.093 mm; analog delay not modeled.&lt;br&gt;The 25 Hz search setting does not guarantee accurate 25 Hz measurement in a 19 ms window." style="fontFamily=Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=16;spacing=9;strokeWidth=1.5;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="1245" width="1640" height="112" as="geometry" />
        </mxCell>
        <mxCell id="source" value="Sources: current RTL / MainProtocol.cs / HARDWARE_WIRING_NOTES.txt; TI ADS127L21 datasheet. Altium was not running; physical rework was not re-inspected." style="fontFamily=Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=12;spacing=9;strokeWidth=1.5;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;spacing=0;fontColor=#334155;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="1373" width="1640" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
