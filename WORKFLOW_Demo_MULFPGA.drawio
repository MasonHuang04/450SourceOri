        <mxCell id="t4_2" value="Nyquist 572.917 kHz &amp;gt; 42 kHz and sum &amp;lt;=84 kHz" style="fontFamily=Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=14;spacing=9;strokeWidth=1.5;align=left;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
