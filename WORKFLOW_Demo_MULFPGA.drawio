        <mxCell id="note_existing" value="&lt;b&gt;Square TX + sine reference verified&lt;/b&gt;&lt;br&gt;Same phase sweep; quarter amplitude preserved.&lt;br&gt;RX propagation delay is retained for beat estimation." style="fontFamily=Arial;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;fontSize=15;spacing=9;strokeWidth=1.5;align=left;verticalAlign=middle;" parent="1" vertex="1">
