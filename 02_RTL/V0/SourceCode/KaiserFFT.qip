# Optional file collection for later integration. Does not select a top or change clocks.
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "fft_tdp_store.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "kaiser4_rfft.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "fft_power_peak.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "kaiser4_fft_peak.sv"]
set_global_assignment -name VERILOG_MACRO "FFT_USE_INTEL_RAM=1"
set_global_assignment -name SEARCH_PATH $::quartus(qip_path)
set_global_assignment -name MIF_FILE [file join $::quartus(qip_path) "window_delta.mif"]
set_global_assignment -name MIF_FILE [file join $::quartus(qip_path) "cos_quarter.mif"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "window_delta.mem"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "cos_quarter.mem"]
