{
  "files.associations": {
    "*.vhd": "vhdl",
    "*.vhdl": "vhdl"
  },
  "vhdlls.languageServer": "embedded",
  "vhdlls.nonProjectFiles": "ignore",
  "[vhdl]": {
    "editor.hover.enabled": "on",
    "editor.hover.delay": 300,
    "editor.semanticHighlighting.enabled": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.formatOnSave": false,
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "search.exclude": {
    "**/db/**": true,
    "**/incremental_db/**": true,
    "**/qdb/**": true,
    "**/*_sim/**": true,
    "**/*.bak": true
  },
  "files.watcherExclude": {
    "**/db/**": true,
    "**/incremental_db/**": true,
    "**/qdb/**": true
  }
}
